{
  "$schema": "https://wails.io/schemas/config.v2.json",
  "name": "scribe",
  "outputfilename": "scribe",
  "build:tags": "webkit2_41",
  "frontend:install": "npm install",
  "frontend:build": "npm run build",
  "frontend:dev:watcher": "npm run dev",
  "frontend:dev:serverUrl": "auto",
  "author": {
    "name": "Scribe contributors",
    "email": ""
  },
  "info": {
    "companyName": "Scribe",
    "productName": "Scribe",
    "productVersion": "0.1.0",
    "copyright": "Copyright 2026 Scribe contributors",
    "comments": "A lean Markdown editor built with Wails and Svelte",
    "fileAssociations": [
      {
        "ext": "md",
        "name": "Markdown Document",
        "description": "Markdown document",
        "role": "Editor",
        "iconName": "appicon"
      },
      {
        "ext": "markdown",
        "name": "Markdown Document",
        "description": "Markdown document",
        "role": "Editor",
        "iconName": "appicon"
      }
    ]
  }
